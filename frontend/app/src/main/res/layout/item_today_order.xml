<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="9dp"
    android:paddingEnd="20dp"
    android:paddingBottom="9dp">

    <!-- Initials avatar -->
    <TextView
        android:id="@+id/tvAvatarInitials"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_initials_circle"
        android:gravity="center"
        android:text="PS"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCustomerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Priya Sharma"
            android:textColor="#111111"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="10:30 AM"
            android:textColor="#999999"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMealSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1.1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="Paneer Thali x 2"
        android:textColor="#444444"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvOrderAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="₹240"
        android:textColor="#111111"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOrderStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/status_chip_preparing"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="Preparing"
        android:textColor="#A8660B"
        android:textSize="10.5sp"
        android:textStyle="bold" />

</LinearLayout>
