<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Title -->
    <TextView
        android:id="@+id/tvSelectTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:text="@string/select_role_title"
        android:textColor="@color/text_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.2" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSelectDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/select_role_desc"
        android:textColor="@color/text_desc"
        android:textSize="14sp" />

    <!-- Customer Card -->
    <LinearLayout
        android:id="@+id/cardCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/card_role_bg_green"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <!-- Avatar with circular background -->
        <ImageView
            android:id="@+id/imgCustomerAvatar"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/circle_avatar_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/role_customer"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_customer" />

        <!-- Text Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCustomerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_customer"
                android:textColor="@color/text_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCustomerDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/role_customer_desc"
                android:textColor="@color/card_subtitle"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Home Cook Card -->
    <LinearLayout
        android:id="@+id/cardCook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/card_role_bg_green"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <!-- Avatar with circular background -->
        <ImageView
            android:id="@+id/imgCookAvatar"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/circle_avatar_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/role_cook"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_cook" />

        <!-- Text Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCookTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_cook"
                android:textColor="@color/text_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCookDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/role_cook_desc"
                android:textColor="@color/card_subtitle"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Spacer to push dots to bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Dot Indicators (matching onboarding style) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Dot 1 (inactive) -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_inactive"
            android:layout_marginEnd="8dp" />

        <!-- Dot 2 (inactive) -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_inactive"
            android:layout_marginEnd="8dp" />

        <!-- Dot 3 (active - green) -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_active" />
    </LinearLayout>

</LinearLayout>