<?xml version="1.0" encoding="utf-8"?><!--
  One cell of the subscription month grid.

  Width is set in code (screen width / 7) because GridLayout has no weight
  equivalent that survives a wrap_content parent — the activity measures once and
  applies it to every cell, so the columns line up with the fixed Sun–Sat header.

  Deliberately small: the cell's job is "which days need me", and the whole story
  for one day lives in the bottom sheet a tap away.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="46dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/layoutCellBody"
        android:layout_width="38dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCellDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="#1F2937"
            android:textSize="13sp"
            tools:text="17" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Status colour. GONE for a day outside the subscription window. -->
            <View
                android:id="@+id/viewCellDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_calendar_dot" />

            <!-- A pending/accepted meal swap. Its own marker rather than a second
                 colour on the dot, because a swap is orthogonal to the day's
                 delivery status — a skipped day can still have had one. -->
            <TextView
                android:id="@+id/tvCellSwap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="◆"
                android:textColor="#7C3AED"
                android:textSize="7sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
