<?xml version="1.0" encoding="utf-8"?>
<!--
  Public combo deal card (cook profile → Combo Deals & Offers).

  Colour roles are the same ones the sibling subscription card uses, so the two
  sections read as one theme instead of two apps: green owns the action, amber
  owns value/savings, ink owns the price. The card previously ran on
  indigo_accent, which is a settings-row accent and put a cold blue block in
  the middle of a green/white screen.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/sub_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/sub_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivComboImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Combo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_food" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvComboName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/sub_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Pasta + Hot Dog + Coke" />

                    <TextView
                        android:id="@+id/tvComboSavings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/pill_savings_blue"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/sub_info_text"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Save ₹80"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvComboDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/sub_text_secondary"
                    android:textSize="12.5sp"
                    android:visibility="gone"
                    tools:text="One coke free with every order"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvComboItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/sub_text_secondary"
            android:textSize="13sp"
            tools:text="1x Pasta, 1x Grilled Hot Dog, 1x Coke" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="One-time meal bundle · not recurring"
            android:textColor="@color/sub_text_strike"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/sub_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvComboPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sub_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="₹450" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuyCombo"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:backgroundTint="@color/sub_primary"
                android:minWidth="112dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Buy Deal"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
