<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Year header, shown by the adapter only on the first row of each year.
         Cheaper than a second view type for a list that is at most 12 rows a
         year, and it keeps the RecyclerView single-type. -->
    <TextView
        android:id="@+id/tvYearHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_app"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:textColor="@color/text_subtitle"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="2026" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- State edge: the one thing that makes verified / pending / rejected
             scannable without reading a single word. Tinted in the adapter. -->
        <View
            android:id="@+id/viewStateEdge"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:minHeight="64dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/circle_bg_green_light">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:contentDescription="Settlement status"
                android:src="@drawable/ic_wallet"
                app:tint="@color/green_primary_dark" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="June 2026"
                android:textColor="@color/text_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="12 orders"
                android:textColor="@color/text_subtitle"
                android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAmountDue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹120"
                android:textColor="@color/text_ink"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/status_chip_pending"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="Pending"
                android:textColor="@color/status_pending_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/viewDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:background="@color/stroke_soft" />

</LinearLayout>
