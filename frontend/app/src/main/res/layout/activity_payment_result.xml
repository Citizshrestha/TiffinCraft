<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ProgressBar
        android:id="@+id/progressChecking"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminateTint="@color/green_primary"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/imgStatusIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:tint="@color/green_primary" />

    <TextView
        android:id="@+id/tvStatusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Confirming your payment…"
        android:textColor="@color/text_title"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatusMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Please wait while we verify your payment with eSewa."
        android:textColor="@color/text_subtitle"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrimaryAction"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="40dp"
        android:text="Refresh Status"
        android:textAllCaps="false"
        android:visibility="gone"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="27dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToOrders"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:text="Back to Orders"
        android:textColor="@color/green_primary"
        android:visibility="gone" />

</LinearLayout>
