<?xml version="1.0" encoding="utf-8"?><!--
  Professional delivery day card with modern visual hierarchy and enhanced status visualization.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/stroke_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Modern accent indicator -->
            <View
                android:id="@+id/viewDayAccent"
                android:layout_width="4dp"
                android:layout_height="40dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_pill_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDayDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:text="Thu, 28 Aug"
                    android:textColor="#1F2937"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDayRelative"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Tomorrow"
                    android:textColor="#6B7280"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDayStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_chip_delivered"
                android:elevation="1dp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="Scheduled"
                android:textColor="@color/status_delivered_text"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cook's reason or customer's note with better styling -->
        <LinearLayout
            android:id="@+id/layoutDayReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="21dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="0dp"
            android:background="#F9FAFB"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="💬"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDayReason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- The meal swap already asked for on this day, if any -->
        <LinearLayout
            android:id="@+id/layoutDayCustomMeal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="21dp"
            android:layout_marginTop="12dp"
            android:background="#F0FDF4"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🍽️"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDayCustomMeal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#166534"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDayCustomMealStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDayCustomMealCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Withdraw"
                android:textColor="@color/sub_error"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!--
          State note. Every non-actionable day lands here — cutoff passed, already
          skipped, delivered, kitchen closed — instead of a full-width disabled
          button, which took the same vertical space as a real action and made a
          settled day look like something the customer had failed to use.
        -->
        <LinearLayout
            android:id="@+id/layoutDayLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="21dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDayNoteIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🔒"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDayLockedNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/text_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <!--
          The sent → received handshake. One button, two meanings, decided by
          whose screen this is: the cook sees "Mark as sent", the customer sees
          "Mark as received" once the cook has sent it. Filled rather than
          outlined because on the one day it appears it is the primary thing to do
          on that row — skipping a day is the secondary action below it.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDayHandshake"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="21dp"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.01"
            android:text="Mark as sent"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="@color/green_primary_dark"
            app:cornerRadius="12dp" />

        <!-- Modern action button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDayAction"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="21dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="0dp"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.01"
            android:text="Skip this day"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/green_primary_dark"
            app:strokeWidth="1.5dp" />

        <!-- Ask for a different meal on this day. Shown only when the server says
             a request would actually be accepted. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDayCustomMeal"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginStart="21dp"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Request a different meal"
            android:textAllCaps="false"
            android:textColor="@color/green_primary_dark"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="12dp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
