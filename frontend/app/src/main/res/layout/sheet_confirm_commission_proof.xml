<?xml version="1.0" encoding="utf-8"?>
<!--
  Confirm-before-submit sheet for a commission payment proof.

  The picker used to fire the upload the instant an image was chosen, so picking
  the wrong photo from the gallery submitted the wrong photo — and undoing that
  means asking an admin to reject it. One tap of friction, showing the actual
  image and the actual amount being claimed, is cheaper than that round trip.

  Same idiom as bottom_sheet_cook_map.xml: bottom_sheet_bg + bg_sheet_handle.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:text="Submit this payment proof?"
        android:textColor="@color/text_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSheetAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:text=""
        android:textColor="@color/text_subtitle"
        android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/stroke_soft"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivSheetPreview"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:contentDescription="Selected payment screenshot"
            android:padding="8dp"
            android:scaleType="fitCenter" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:text="An admin will verify this within 24 hours. Make sure the amount and date are readable."
        android:textColor="@color/text_subtitle"
        android:textSize="12.5sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="@color/green_primary_dark"
        android:letterSpacing="0"
        android:text="Submit"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetChooseAnother"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:letterSpacing="0"
        android:text="Choose another"
        android:textAllCaps="false"
        android:textColor="@color/green_primary_dark"
        app:cornerRadius="12dp"
        app:strokeColor="@color/stroke_soft" />

</LinearLayout>
