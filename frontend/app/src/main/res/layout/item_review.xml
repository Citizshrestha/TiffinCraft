<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="10dp" android:layout_marginEnd="16dp" android:layout_marginBottom="2dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/stroke_soft" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/tvCustomerInitial" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_avatar_circle" android:gravity="center" android:text="A" android:textColor="@color/forest" android:textSize="16sp" android:textStyle="bold" tools:text="J" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/tvCustomerName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jane Smith" android:textColor="@color/text_ink" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Today, 4:51 PM" android:textColor="@color/text_secondary" android:textSize="12sp" /></LinearLayout>
            <ImageButton android:id="@+id/btnReviewMore" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Review actions" android:padding="10dp" android:src="@drawable/ic_more_vert" android:tint="@color/text_secondary" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_pill_gold" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp"><TextView android:id="@+id/tvRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5.0" android:textColor="@color/gold_deep" android:textSize="13sp" android:textStyle="bold" /><RatingBar android:id="@+id/ratingBar" style="?android:attr/ratingBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:isIndicator="true" android:numStars="5" android:progressTint="@color/gold_accent" /></LinearLayout>
        <TextView android:id="@+id/tvMealName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_pill_green_soft" android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp" android:text="Veg Thali" android:textColor="@color/forest" android:textSize="12sp" android:visibility="gone" />
        <TextView android:id="@+id/tvComment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:text="The food was delicious and arrived hot. Will definitely order again!" android:textColor="@color/text_ink" android:textSize="14sp" />
        <LinearLayout android:id="@+id/layoutCookReply" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@color/green_surface_light" android:orientation="vertical" android:padding="12dp" android:visibility="gone" tools:visibility="visible"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR RESPONSE" android:textColor="@color/forest" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" /><TextView android:id="@+id/tvCookReply" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:lineSpacingExtra="2dp" android:text="Thank you for your kind words!" android:textColor="@color/text_ink" android:textSize="14sp" /></LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/stroke_soft" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical"><com.google.android.material.button.MaterialButton android:id="@+id/btnReply" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="40dp" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:text="Reply" android:textAllCaps="false" android:textColor="@color/forest" android:textSize="14sp" app:icon="@drawable/ic_reply" app:iconGravity="textStart" app:iconTint="@color/forest" /><TextView android:id="@+id/tvLikeCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_secondary" android:textSize="12sp" /></LinearLayout>
        <LinearLayout android:id="@+id/layoutOwnReviewActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:orientation="horizontal" android:visibility="gone"><com.google.android.material.button.MaterialButton android:id="@+id/btnEditReview" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit" android:textAllCaps="false" /><com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteReview" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delete" android:textAllCaps="false" android:textColor="@color/error_red" /></LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
