<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <!-- 1. Back Button -->
        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/logo_card_bg"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back"
                android:tint="#111111" />
        </LinearLayout>

        <!-- 2. Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:text="@string/create_account"
            android:textColor="#111111"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 3. Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="28dp"
            android:text="Let\'s get you started"
            android:textColor="#888888"
            android:textSize="14sp" />

        <!-- 4. Role Badge Chip -->
        <TextView
            android:id="@+id/tvRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/role_chip_bg"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/registering_as_customer"
            android:textColor="#4CAF50"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 5. Full Name Input -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/input_rounded_bg"
            android:drawableStart="@drawable/ic_person"
            android:drawablePadding="12dp"
            android:drawableTint="#4CAF50"
            android:hint="@string/full_name"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#111111"
            android:textColorHint="#AAAAAA"
            android:textSize="15sp" />

        <!-- 6. Phone Number Input -->
        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/input_rounded_bg"
            android:drawableStart="@drawable/ic_phone"
            android:drawablePadding="12dp"
            android:drawableTint="#4CAF50"
            android:hint="@string/phone_number"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#111111"
            android:textColorHint="#AAAAAA"
            android:textSize="15sp" />

        <!-- 7. Email Address Input -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/input_rounded_bg"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="12dp"
            android:drawableTint="#4CAF50"
            android:hint="@string/email_address"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#111111"
            android:textColorHint="#AAAAAA"
            android:textSize="15sp" />

        <!-- 8. Password Input (with eye toggle) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/input_rounded_bg"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:drawableTint="#4CAF50"
                android:hint="@string/password"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:paddingEnd="52dp"
                android:textColor="#111111"
                android:textColorHint="#AAAAAA"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgTogglePassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:contentDescription="Toggle password visibility"
                android:focusable="true"
                android:src="@drawable/ic_eye"
                android:tint="#4CAF50" />
        </RelativeLayout>

        <!-- 9. Confirm Password Input (with eye toggle) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/input_rounded_bg"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:drawableTint="#4CAF50"
                android:hint="@string/confirm_password"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:paddingEnd="52dp"
                android:textColor="#111111"
                android:textColorHint="#AAAAAA"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgToggleConfirm"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:contentDescription="Toggle confirm password visibility"
                android:focusable="true"
                android:src="@drawable/ic_eye"
                android:tint="#4CAF50" />
        </RelativeLayout>

        <!-- 10. Sign Up Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="24dp"
            android:text="Sign Up"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#4CAF50"
            app:cornerRadius="27dp"
            app:elevation="0dp" />

        <!-- 11. OR DIVIDER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/or_divider"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <!-- 12. SOCIAL BUTTONS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Google Button -->
            <LinearLayout
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/social_btn_circle"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Google sign in"
                    android:src="@drawable/ic_google" />
            </LinearLayout>

            <!-- Facebook Button -->
            <LinearLayout
                android:id="@+id/btnFacebookSignIn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/social_btn_circle"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Facebook sign in"
                    android:src="@drawable/ic_facebook" />
            </LinearLayout>
        </LinearLayout>

        <!-- 13. Login Link -->
        <LinearLayout
            android:id="@+id/layoutLoginLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_have_account"
                android:textColor="#888888"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/login_btn"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
