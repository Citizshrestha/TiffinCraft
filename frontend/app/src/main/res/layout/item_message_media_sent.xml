<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@drawable/bg_bubble_sent"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Chat image"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/viewVideoScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivVideoPlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_video_play_button"
                android:contentDescription="Play video"
                android:padding="14dp"
                android:src="@drawable/ic_play"
                android:tint="@android:color/white"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="12:38 PM"
            android:textColor="#BDBDBD"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
