<?xml version="1.0" encoding="utf-8"?><!--
  Ring around today's cell in the subscription month grid. An outline rather than
  a fill so it can't be mistaken for a status colour.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="#F0FDF4" />
    <stroke
        android:width="1.5dp"
        android:color="@color/green_primary_dark" />
</shape>
