<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Light-only theme. This app never uses a dark/night appearance, so the
         parent is Light (not DayNight) and the surface tokens are pinned to light
         values. This keeps MaterialCardView, dialogs and menus white with dark
         text even when the device is in system dark mode. -->
    <style name="Base.Theme.TiffinCraft" parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_primary_dark</item>
        <item name="colorSecondary">@color/green_primary_light</item>
        <item name="colorTertiary">@color/green_surface_light</item>

        <!-- Pin light surfaces so cards/dialogs never resolve dark -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>

    <style name="Theme.TiffinCraft" parent="Base.Theme.TiffinCraft" />

    <style name="Theme.TiffinCraft.NoActionBar" parent="Theme.TiffinCraft">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.TiffinCraft.Splash" parent="Theme.TiffinCraft.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Material DatePicker Theme -->
    <style name="ThemeOverlay.App.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <!-- Header background color -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Selected date color -->
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Surface/dialog colors -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        
        <!-- Typography -->
        <item name="textAppearanceHeadline4">@style/TextAppearance.App.DatePicker.Headline</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.App.DatePicker.MonthYear</item>
        <item name="textAppearanceBody1">@style/TextAppearance.App.DatePicker.Day</item>
        
        <!-- Shape -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.DatePicker</item>
    </style>

    <!-- DatePicker Text Styles -->
    <style name="TextAppearance.App.DatePicker.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.DatePicker.MonthYear" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.DatePicker.Day" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- DatePicker Shape -->
    <style name="ShapeAppearance.App.DatePicker" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Rounded White Dialog Theme - Used for clean, modern dialogs -->
    <style name="RoundedWhiteDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/green_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogNegativeButton</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Dialog</item>
    </style>

    <!-- Dialog Title Style -->
    <style name="DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Dialog Body Style -->
    <style name="DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- Dialog Positive Button (Primary Action) -->
    <style name="DialogPositiveButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/green_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Dialog Negative Button (Secondary Action) -->
    <style name="DialogNegativeButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Dialog Shape - Rounded corners -->
    <style name="ShapeAppearance.App.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

</resources>