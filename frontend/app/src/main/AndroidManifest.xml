<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TiffinCraft"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Facebook App ID -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id"/>

        <!-- Facebook Client Token -->
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token"/>

        <!-- Facebook Login Activity -->
        <activity
            android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:label="@string/app_name" />

        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/fb_login_protocol_scheme" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.onboarding.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TiffinCraft.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.onboarding.OnboardingActivity1"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.onboarding.OnboardingActivity2"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.onboarding.SelectRoleActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.auth.LoginActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.auth.ForgotPasswordActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.auth.RegisterActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.auth.OtpActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.auth.ResetPasswordActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.CustomerHomeActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookHomeActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.AddMenuActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.ManageOrdersActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookProfileActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookEarningsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookSplashActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.meal.CookListActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.meal.CookDetailsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.meal.MealSelectionActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.common.CartActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.common.DeliveryAddressActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.OrderSummaryActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.OrderPlacedActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.TrackOrderActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.OrderHistoryActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.OrderDetailsCustomerActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.OrderDetailsCookActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.UpdateStatusActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.FavoritesActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.common.SearchFilterActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.common.RateReviewActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.CustomerProfileActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

    </application>

</manifest>
