<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!-- Android 11+ (API 30+) package visibility: without this, PackageManager
         hides other apps from resolveActivity()/queryIntentActivities() by
         default — so the eSewa deeplink launch would report "not installed"
         even when the eSewa app genuinely is on the device. -->
    <queries>
        <!-- eSewa's real package id, confirmed two ways: `pm list packages`
             on a device with eSewa installed, and the package= parameter in
             the intent:// URL eSewa's own rc-links deeplink redirects to.
             Required on Android 11+ for resolveActivity/setPackage to see the
             eSewa app at all. -->
        <package android:name="com.f1soft.esewa"/>
    </queries>

    <application
        android:name=".TiffinCraftApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TiffinCraft"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>

        <activity
            android:name=".activities.onboarding.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TiffinCraft.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.onboarding.OnboardingActivity1"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.onboarding.OnboardingActivity2"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.onboarding.SelectRoleActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.auth.LoginActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.auth.ForgotPasswordActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.auth.RegisterActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.auth.OtpActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.auth.ResetPasswordActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.CustomerHomeActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookHomeActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookMealActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.AddMenuActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.EditMealActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.ManageOrdersActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookProfileActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookEarningsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.AllTransactionsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CommissionSettlementActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CommissionHistoryActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookSplashActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.meal.CookListActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.meal.CookDetailsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>
        <activity
            android:name=".activities.customer.CustomerDetailsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.meal.MealSelectionActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.common.CartActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.common.DeliveryAddressActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.OrderSummaryActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.OrderPlacedActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.TrackOrderActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.OrderHistoryActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.OrderDetailsCustomerActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.order.OrderDetailsCookActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <!-- ePay v2 fallback checkout (WebView-hosted, not the deprecated SDK)
             — used when Intent Payment's own sandbox/deeplink isn't available. -->
        <activity
            android:name=".activities.order.EsewaEpayCheckoutActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <!-- eSewa Intent Payment redirect target. redirect_url sent to eSewa
             during booking is tiffincraft://payment-result — see PaymentResultActivity. -->
        <activity
            android:name=".activities.order.PaymentResultActivity"
            android:exported="true"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tiffincraft" android:host="payment-result"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.cook.UpdateStatusActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.CustomerMenuActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.FavoritesActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.common.SearchFilterActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.common.RateReviewActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.CustomerProfileActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.EditCustomerProfileActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.SubscriptionPaymentActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.CustomerSubscriptionsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <!-- Per-day delivery schedule. Opened by both sides — the response's
             `viewer` field, not the session role, decides what's actionable. -->
        <activity
            android:name=".activities.customer.SubscriptionCalendarActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.CustomerSettingsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.ReferEarnActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.customer.NearbyCooksMapActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.EditCookProfileActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.common.NotificationActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.common.MediaViewerActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <!-- New Cook Activities -->
        <activity
            android:name=".activities.cook.CookReviewsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.ReplyToReviewActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookSettingsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.BankDetailsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookSubscriptionsActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.SubscriptionPlanFormActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookSubscribersActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.TodayDeliveriesActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.CookCombosActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.ComboFormActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.OperatingHoursActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.ChangePasswordActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
            android:name=".activities.cook.NotificationPreferencesActivity"
            android:theme="@style/Theme.TiffinCraft.NoActionBar"/>

        <activity
     android:name=".activities.common.ChatActivity"
     android:theme="@style/Theme.TiffinCraft.NoActionBar"
     android:windowSoftInputMode="adjustResize"/>

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".services.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
